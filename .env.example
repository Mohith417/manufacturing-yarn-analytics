# Copy to .env at the repository root (gitignored) and adjust.
# These are local development values only: no hosted credential and no API key
# is required for this project. Never put a real secret in this file.
#
# Compose reads this file through --env-file, so a value here reaches both
# containers:
#   docker compose --env-file .env -f docker/docker-compose.app.yml up --build

POSTGRES_USER=yarnlens
POSTGRES_PASSWORD=yarnlens
POSTGRES_DB=yarnlens
POSTGRES_PORT=5433

API_PORT=8000
SIMULATED_INTERVAL_SECONDS=3
HISTORY_RETENTION=100000
