# Example for C:\Users\<you>\.wslconfig  (NOT inside this repo - WSL reads it
# from your Windows home directory).
#
# Why: Docker Desktop runs inside the WSL2 VM. By default WSL2 takes about half
# of physical RAM (~7.8 GB of this 16 GB laptop, measured as MemTotal in
# `docker info`). Reserving 10 GB gives the 10 containers room while leaving
# ~5.6 GB for Windows itself.
#
# To apply: save as %USERPROFILE%\.wslconfig, run `wsl --shutdown` in PowerShell,
# then start Docker Desktop again and re-check with:
#   docker info --format '{{.MemTotal}}'
# 10 GB = 10737418240 bytes.
#
# If the machine feels starved, lower memory to 8GB; if `docker compose up`
# reports OOM-kills, that is the signal to trim container mem_limit values in
# docker-compose.yml instead of raising this further on a 16 GB laptop.

[wsl2]
memory=10GB
processors=4
swap=2GB
