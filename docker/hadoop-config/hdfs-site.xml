<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!-- HDFS settings for a 2-DataNode lab cluster.
     replication=2 because there are exactly 2 DataNodes: each block really is
     stored twice, on two different containers. -->
<configuration>
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///data/namenode</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///data/datanode</value>
  </property>
  <property>
    <name>dfs.blocksize</name>
    <value>134217728</value>
  </property>
  <!-- Deliberately NO dfs.namenode.rpc-address / http-address here: those
       properties are also what CLIENTS read to find the NameNode, so setting
       them to 0.0.0.0 makes DataNodes dial 0.0.0.0:9000 and never register
       (measured: "Configured Capacity: 0", DataNode log "Problem connecting to
       server: 0.0.0.0/0.0.0.0:9000"). The bind address comes from fs.defaultFS
       (hdfs://namenode:9000) and the Hadoop defaults (0.0.0.0 ports). -->
  <property>
    <name>dfs.namenode.datanode.registration.ip-hostname-check</name>
    <value>false</value>
  </property>
  <property>
    <name>dfs.webhdfs.enabled</name>
    <value>true</value>
  </property>
</configuration>
